  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.2.0",
    "@cap-js/cds-types": "^0.9.0",
    "@cap-js/sqlite": "^1",
    "@sap/eslint-plugin-cds": "^3.2.0",
    "eslint": "^9.21.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": "20.17",
    "npm": "9.9"
  },
